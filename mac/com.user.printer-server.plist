<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <key>Label</key>
    <string>com.user.printerserver</string>

    <key>ProgramArguments</key>
    <array>
      <string>/opt/homebrew/bin/podman</string>
      <string>start</string>
      <string>printer-server</string>
    </array>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <true/>

    <key>StandardOutPath</key>
    <string>/tmp/printer-server.out</string>
    <key>StandardErrorPath</key>
    <string>/tmp/printer-server.err</string>
  </dict>
</plist>